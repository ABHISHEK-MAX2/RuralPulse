# Karnataka Rural Healthcare Intelligence Platform - Environment Configuration Template

# Groq Cloud API Configuration (Secondary LLM Fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound

# IBM watsonx.ai API Configuration (Primary LLM Engine)
WATSONX_APIKEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# xAI Grok API Configuration (Tertiary LLM Fallback)
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-beta

# Core Backend Platform Configuration
SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./krhi.db
ENVIRONMENT=development
DEMO_MODE=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
